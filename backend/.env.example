DATABASE_URL=postgresql+psycopg://signflow:signflow@localhost:5432/signflow
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=15
APP_BASE_URL=http://localhost:3000
UPLOAD_DIR=./uploads
SIGNING_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=development


# Observability
LOG_LEVEL=INFO

# Object storage: "local" (default) or "s3"
STORAGE_BACKEND=local
# S3_BUCKET=signflow-documents
# S3_PREFIX=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_SERVER_SIDE_ENCRYPTION=AES256
# S3_SSE_KMS_KEY_ID=
# S3_PRESIGN_EXPIRES_SECONDS=900

# Encryption of tenant gateway secrets at rest (REQUIRED when ENVIRONMENT=production)
SECRET_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Retired keys during rotation, comma separated "version:secret"
# SECRET_ENCRYPTION_KEYS_OLD=

# Expiry scheduler (scripts/run_expiry.py)
EXPIRY_BATCH_SIZE=500

# Billing / payment provider seam
BILLING_PROVIDER=null
# REQUIRED in production: startup hard-fails on this shipped default, or on any
# value shorter than 32 characters. A provider webhook signed with a published
# constant lets anyone self-grant an enterprise plan.
BILLING_WEBHOOK_SECRET=dev-billing-webhook-secret
# Only read when BILLING_PROVIDER=stripe.
#
# STRIPE_SECRET_KEY: Dashboard -> Developers -> API keys -> "Secret key".
#   Use the TEST-mode key (sk_test_...). A live key (sk_live_...) is refused at
#   startup unless ENVIRONMENT=production, because a live key on a developer's
#   machine charges real cards. Never expose this to the browser -- the
#   frontend gets the *publishable* key instead (frontend/.env.example).
#
# STRIPE_WEBHOOK_SECRET: the `whsec_...` endpoint signing secret, a different
#   value from BILLING_WEBHOOK_SECRET above. Locally it is printed by
#   `stripe listen --forward-to localhost:8000/api/billing/webhook`; in a
#   deployment it comes from Dashboard -> Developers -> Webhooks -> your
#   endpoint -> "Signing secret".
#
# With BILLING_PROVIDER=stripe, run `python scripts/provision_stripe_plans.py`
# once against a fresh database: it creates the Products/Prices and writes the
# price ids back to plans.external_price_id, without which checkout is a 409.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Signer payments (Stripe Connect) ------------------------------------
# Lets a signer pay the TENANT directly (a deposit, an invoice, a retainer)
# during signing, as a direct charge on the tenant's own connected Stripe
# account -- not the platform's. Only read when BILLING_PROVIDER=stripe and
# STRIPE_SECRET_KEY is set above; the tenant's own account is connected later,
# per-organization, from Settings -> Payments in the app, not from here.
#
# REQUIRED for signer payments to work at all:
#
# STRIPE_CONNECT_WEBHOOK_SECRET: the `whsec_...` signing secret for a SEPARATE
#   Stripe webhook endpoint -- POST /api/webhooks/stripe/connect -- listening
#   for `payment_intent.succeeded`, `payment_intent.payment_failed` and
#   `account.updated`. This is NOT the same secret as STRIPE_WEBHOOK_SECRET
#   above, which signs the *billing* endpoint (subscription events on the
#   platform's own Stripe account). Crossing the two is the single most
#   likely misconfiguration here: each endpoint has its own Dashboard entry
#   and its own "Signing secret", and pointing this at the wrong one makes
#   every Connect webhook fail signature verification silently (Stripe sees
#   only a 400; nothing in this app's own logs points at the mismatch).
#   Locally: `stripe listen --forward-to localhost:8000/api/webhooks/stripe/connect`.
#   If left unset, `stripe_connect_service` falls back to STRIPE_WEBHOOK_SECRET,
#   which only works if you deliberately point both endpoints at the same
#   secret -- do not rely on this in production.
#
# STRIPE_PUBLISHABLE_KEY: Dashboard -> Developers -> API keys -> "Publishable
#   key" (pk_test_... in test mode, matching the mode of STRIPE_SECRET_KEY).
#   Safe to expose -- it can only tokenize a card, never charge or read
#   anything -- and is handed to the signing client over the API so it can
#   mount Stripe Elements against the tenant's connected account. This is a
#   different variable from frontend/.env.example's
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, which is for the platform's OWN
#   billing checkout and is baked into the frontend bundle at build time; this
#   one is read server-side by the backend and returned in the payment-intent
#   response, so it does not need a NEXT_PUBLIC_ variable at all.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Optional / not env-configured at all:
#   - A tenant's own connected account id (`acct_...`) is NOT an env var: it is
#     created and stored per-organization (`payment_accounts` table) the first
#     time that tenant visits Settings -> Payments and starts onboarding.
#   - There is no separate "signer payments enabled" flag. The feature is live
#     the moment STRIPE_SECRET_KEY + STRIPE_PUBLISHABLE_KEY +
#     STRIPE_CONNECT_WEBHOOK_SECRET are set; individual tenants are still
#     gated on their own `charges_enabled` before they can send a document
#     carrying a payment field.

# Database connection pool
# Budget: replicas x WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) must
# stay under the Postgres max_connections (100 by default). SQLAlchemy's own
# defaults (5 + 10 per worker) blow past that at three replicas; these do not.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# Recycle below any proxy/server idle timeout (PgBouncer, RDS), so the pool
# never hands out a connection the server has already closed.
DB_POOL_RECYCLE_SECONDS=1800
# Fail fast when the pool is exhausted instead of queueing behind it.
DB_POOL_TIMEOUT_SECONDS=10

# Rate limiting: "memory" (single process) or "redis" (shared across replicas).
# Memory counters live per worker process, so N replicas x M workers multiply
# every login / OTP / password-reset limit by N*M. Use redis for anything
# beyond one worker.
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Retention: days of system_logs to keep, pruned by scripts/run_log_retention.py
# (scheduled as log-retention-scheduler in docker-compose.prod.yml). The table
# is append-only, and the rows carry actor emails and IPs -- keeping them
# forever is both a disk and a GDPR problem. 0 disables pruning.
SYSTEM_LOG_RETENTION_DAYS=90
# Rows per transaction, and a ceiling on batches per run so a first pass over a
# large backlog stays bounded; the next run resumes where it stopped.
LOG_RETENTION_BATCH_SIZE=5000
LOG_RETENTION_MAX_BATCHES=200
