# Environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod && $EDITOR .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Values with no default in the compose file are REQUIRED: it uses `${VAR:?}`,
# so a missing secret fails the deploy loudly instead of falling back to a
# published constant. Everything else has a compose-side default and is listed
# here so the knob is discoverable.
# .env.prod itself must never be committed (see .gitignore).

# --- Database ---------------------------------------------------------------
POSTGRES_DB=signforge
POSTGRES_USER=signforge
POSTGRES_PASSWORD=          # REQUIRED. openssl rand -base64 32

# --- Secrets ----------------------------------------------------------------
# Generate each independently: openssl rand -base64 48
# The application refuses to start in production if any of these is a shipped
# default or shorter than 32 characters.
JWT_SECRET=                 # REQUIRED
SECRET_ENCRYPTION_KEY=      # REQUIRED
JWT_EXPIRES_MINUTES=480

# --- URLs -------------------------------------------------------------------
# Must be HTTPS in production: `secure` session cookies require it.
APP_BASE_URL=https://app.example.com          # REQUIRED
CORS_ORIGINS=https://app.example.com          # REQUIRED (no "*"; credentialed API)
NEXT_PUBLIC_API_URL=https://app.example.com   # REQUIRED (baked into the frontend image)

# --- Billing ----------------------------------------------------------------
# REQUIRED: signs the inbound provider webhook. The shipped development default
# is rejected at startup in production -- a webhook signed with a published
# constant lets anyone self-grant an enterprise plan. 32+ characters.
BILLING_WEBHOOK_SECRET=      # REQUIRED, >=32 chars. openssl rand -base64 32
# REQUIRED, and it may NOT be "null" here. The null provider accepts every
# plan change and collects no money, so the application refuses to start with
# it in production. "stripe" is currently the only other registered provider,
# which makes the two keys below required as well: nothing constructs the
# provider at startup, so a missing key stays invisible until the first charge
# attempt -- until real money fails to move.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=          # REQUIRED. sk_live_...
# The `whsec_...` endpoint signing secret from the Stripe dashboard. A
# different value from BILLING_WEBHOOK_SECRET above.
STRIPE_WEBHOOK_SECRET=      # REQUIRED. whsec_...
# The publishable key, inlined into the frontend bundle at BUILD time (it is a
# docker build arg, not a runtime env var -- changing it needs a rebuild).
# Safe to expose: it can only mount Checkout, never read or charge.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # REQUIRED for payments. pk_live_...
#
# On a fresh database, once per environment:
#   docker compose -f docker-compose.prod.yml run --rm api \
#     python scripts/provision_stripe_plans.py

# --- Signer payments (Stripe Connect) ----------------------------------------
# Optional: a signer pays the TENANT's own connected Stripe account directly
# (a deposit, an invoice, a retainer), not the platform's -- see DEPLOYMENT.md
# "Enabling signer payments". Unset, the feature simply 409s; nothing else
# breaks. Individual tenants connect their own account later, in-app, at
# Settings -> Payments -- there is no per-tenant env var.
#
# The server-side publishable key handed to the signing client so it can
# mount Stripe Elements against the tenant's connected account. A DIFFERENT
# variable from NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY above, which is for the
# platform's own billing checkout and is baked into the frontend at build
# time; this one is read by the backend at runtime.
STRIPE_PUBLISHABLE_KEY=      # pk_live_...
# The `whsec_...` signing secret for a SEPARATE Stripe webhook endpoint,
# POST /api/webhooks/stripe/connect (`payment_intent.succeeded`,
# `payment_intent.payment_failed`, `account.updated`). This is NOT the same
# secret as STRIPE_WEBHOOK_SECRET above -- that one signs the billing
# endpoint on a different Stripe Dashboard entry. Crossing the two makes every
# Connect webhook fail signature verification.
STRIPE_CONNECT_WEBHOOK_SECRET=   # whsec_...
# (it refuses a live key -- provision live prices deliberately, from the
# Stripe dashboard, and paste the ids into plans.external_price_id)

# --- Embedding --------------------------------------------------------------
# Space-separated CSP source list of origins allowed to frame /sign/*, e.g.
# "https://app.customer.com https://*.partner.io". Empty (the default) means
# frame-ancestors 'none' -- the signing page cannot be framed at all, which is
# what closes the clickjacking hole on a page that produces signatures.
#
# This is consumed as a BUILD ARG, not a runtime variable: Next evaluates
# headers() during `next build` and bakes the CSP into routes-manifest.json.
# Changing it requires rebuilding the frontend image (`docker compose -f
# docker-compose.prod.yml build frontend`), not just restarting the container.
EMBED_FRAME_ANCESTORS=

# --- Sizing -----------------------------------------------------------------
# Connection budget: replicas x WEB_CONCURRENCY x (DB_POOL_SIZE +
# DB_MAX_OVERFLOW) must stay under the Postgres `max_connections` (default
# 100). At the defaults below: 1 x 4 x 5 = 20. See AUDIT_REPORT.md section 9.
WEB_CONCURRENCY=4
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# Recycle below any proxy/server idle timeout (PgBouncer, RDS).
DB_POOL_RECYCLE_SECONDS=1800
# Fail fast on pool exhaustion instead of queueing requests behind it.
DB_POOL_TIMEOUT_SECONDS=10

# --- Rate limiting ----------------------------------------------------------
# "memory" counters live in one process, so N replicas x WEB_CONCURRENCY
# workers multiply every login / OTP / password-reset limit by N*M. Anything
# beyond a single worker should use "redis", which is served by the `redis`
# compose profile:
#
#   docker compose -f docker-compose.prod.yml --profile redis \
#     --env-file .env.prod up -d
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://redis:6379/0

# --- Storage ----------------------------------------------------------------
# "local" is single-node: the uploads volume is not shared, so scaling the
# backend past one replica requires "s3". The S3_* settings are read from the
# container environment; add them to the backend service if you switch.
STORAGE_BACKEND=local

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO

# --- Scheduled jobs ---------------------------------------------------------
EXPIRY_INTERVAL_SECONDS=600
WEBHOOK_RETRY_INTERVAL_SECONDS=60
# Renewals, period-close invoicing and dunning retries. Hourly.
BILLING_CYCLE_INTERVAL_SECONDS=3600
# system_logs pruning. Daily; the window itself is SYSTEM_LOG_RETENTION_DAYS.
LOG_RETENTION_INTERVAL_SECONDS=86400
SYSTEM_LOG_RETENTION_DAYS=90
# Rows per transaction, and a per-run batch ceiling so a first run against a
# large backlog stays bounded (the next run continues where it stopped).
LOG_RETENTION_BATCH_SIZE=5000
LOG_RETENTION_MAX_BATCHES=200

# --- Images (optional; set when deploying pre-built images from a registry) --
# BACKEND_IMAGE=ghcr.io/example/signforge-backend:1.2.3
# FRONTEND_IMAGE=ghcr.io/example/signforge-frontend:1.2.3

# Comma-separated IPs/CIDRs of the reverse proxies in front of the backend.
# X-Forwarded-For is only honoured from these. REQUIRED behind an ingress, or
# every client shares one rate-limit bucket. Empty = ignore the header.
TRUSTED_PROXY_IPS=
