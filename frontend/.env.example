# Backend the Next server (route handlers, server components, middleware) talks to.
BACKEND_URL=http://localhost:8000

# Public base of the API, if a browser ever needs it directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared HS256 signing secret, identical to the backend's JWT_SECRET. Required
# for the middleware / server session layer to *verify* the session cookie
# rather than merely decode it. Without it, a session is treated as unverified
# and platform-admin routes are refused (see ALLOW_UNVERIFIED_PLATFORM_ACCESS).
SESSION_JWT_SECRET=change-me-in-production

# Local-development escape hatch: allow platform-admin routes on a session
# whose signature could not be verified. Never set this outside development.
# ALLOW_UNVERIFIED_PLATFORM_ACCESS=true

# Session cookie `Secure` flag. Keyed on the deployment, not on NODE_ENV: leave
# unset and it is derived from APP_BASE_URL / APP_ENV, defaulting to NODE_ENV.
# SESSION_COOKIE_SECURE=true
# APP_BASE_URL=https://app.example.com

# Origins allowed to frame the signing surface (/sign/*), as a space-separated
# CSP source list, e.g. "https://app.customer.com https://*.partner.io".
# Unset/empty means `frame-ancestors 'none'`: the signing page cannot be framed
# at all. That default is deliberate -- framing an e-signature page invisibly
# is how a victim is tricked into producing a signature -- so the embed flow
# has to opt each origin in explicitly.
#
# `next dev` re-reads this per request, so it behaves like a normal env var
# locally. In a built image it does NOT: next.config.ts#headers() is evaluated
# during `next build` and the CSP is baked into .next/routes-manifest.json, so
# production must pass it as the EMBED_FRAME_ANCESTORS Docker *build arg* and
# rebuild to change it. See frontend/Dockerfile and docker-compose.prod.yml.
# EMBED_FRAME_ANCESTORS=

# Stripe publishable key, for the embedded Checkout iframe.
#
# This one is MEANT to be in the browser bundle: that is what "publishable"
# means. It can create tokens and mount Checkout, and it cannot read a
# customer, list a charge, or take a payment. Dashboard → Developers → API
# keys → "Publishable key" (pk_test_… in test mode).
#
# The SECRET key (sk_test_…/sk_live_…) is the opposite: it must never appear
# in this file, in NEXT_PUBLIC_* anything, or anywhere the browser can reach.
# It belongs in backend/.env as STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

